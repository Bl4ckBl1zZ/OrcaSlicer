# Sources of the built-in MCP server (Slic3r::GUI::Mcp). Included by src/slic3r/CMakeLists.txt
# when SLIC3R_MCP is ON; paths are relative to src/slic3r.
#
# The lists are globbed on purpose: tool groups are developed in parallel, and a hand-written list
# would make every new file a merge conflict.
#
#   Mcp/*.cpp, *.hpp              the core
#   Mcp/tools/Tools<Group>.cpp    one tool group each; must define MCP_TOOL_GROUP(<Group>)
#   Mcp/tools/**                  anything else under tools/ (helpers of a group) is compiled too,
#                                 as long as its name does not match Tools<Group>.cpp
#
# CONFIGURE_DEPENDS makes the build re-run CMake when a file is added or removed.

file(GLOB SLIC3R_MCP_CORE_SOURCES CONFIGURE_DEPENDS RELATIVE "${CMAKE_CURRENT_SOURCE_DIR}"
    "${CMAKE_CURRENT_SOURCE_DIR}/Mcp/*.cpp"
    "${CMAKE_CURRENT_SOURCE_DIR}/Mcp/*.hpp")
file(GLOB_RECURSE SLIC3R_MCP_TOOL_SOURCES CONFIGURE_DEPENDS RELATIVE "${CMAKE_CURRENT_SOURCE_DIR}"
    "${CMAKE_CURRENT_SOURCE_DIR}/Mcp/tools/*.cpp"
    "${CMAKE_CURRENT_SOURCE_DIR}/Mcp/tools/*.hpp")
list(SORT SLIC3R_MCP_CORE_SOURCES)
list(SORT SLIC3R_MCP_TOOL_SOURCES)
set(SLIC3R_MCP_SOURCES ${SLIC3R_MCP_CORE_SOURCES} ${SLIC3R_MCP_TOOL_SOURCES})

# McpToolGroups.inc: one MCP_GROUP(<Group>) line per tools/Tools<Group>.cpp, in alphabetical
# order. McpRegistry.cpp includes it to declare and call every group's registration function.
set(_mcp_groups "// Generated by src/slic3r/Mcp/McpSources.cmake from the files in Mcp/tools. Do not edit.\n")
foreach (_mcp_source ${SLIC3R_MCP_TOOL_SOURCES})
    get_filename_component(_mcp_dir "${_mcp_source}" DIRECTORY)
    get_filename_component(_mcp_name "${_mcp_source}" NAME)
    if (_mcp_dir STREQUAL "Mcp/tools" AND _mcp_name MATCHES "^Tools([A-Za-z0-9]+)\\.cpp$")
        string(APPEND _mcp_groups "MCP_GROUP(${CMAKE_MATCH_1})\n")
    endif ()
endforeach ()
set(_mcp_groups_file "${CMAKE_CURRENT_BINARY_DIR}/McpToolGroups.inc")
set(_mcp_groups_old "")
if (EXISTS "${_mcp_groups_file}")
    file(READ "${_mcp_groups_file}" _mcp_groups_old)
endif ()
if (NOT _mcp_groups STREQUAL _mcp_groups_old)
    file(WRITE "${_mcp_groups_file}" "${_mcp_groups}")
endif ()
unset(_mcp_groups)
unset(_mcp_groups_old)
unset(_mcp_groups_file)
