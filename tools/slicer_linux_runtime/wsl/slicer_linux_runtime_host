#!/bin/sh
set -eu

DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
CACHE_FILE="$DIR/.selected_host_abi"
# Runs the x86-64 host through an emulator on other architectures, e.g. "qemu-x86_64 -L /opt/x64root"
# on macOS, where the Linux machine is arm64. Word-split on purpose.
EXEC_PREFIX="${SLICER_LINUX_RUNTIME_EXEC_PREFIX:-}"

run_probe() {
    bin="$1"
    [ -x "$bin" ] || return 1
    LD_LIBRARY_PATH="$DIR${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" \
    SLICER_LINUX_RUNTIME_PROBE_LOG_DIR="${SLICER_LINUX_RUNTIME_PROBE_LOG_DIR:-$DIR}" \
    SLICER_LINUX_RUNTIME_COUNTRY_CODE="${SLICER_LINUX_RUNTIME_COUNTRY_CODE:-US}" \
    $EXEC_PREFIX "$bin" --probe-auth >/dev/null 2>&1
}

choose_bin() {
    forced="${SLICER_LINUX_RUNTIME_FORCE_HOST_ABI:-}"
    if [ -n "$forced" ] && [ -x "$DIR/slicer_linux_runtime_host_$forced" ]; then
        printf '%s\n' "$DIR/slicer_linux_runtime_host_$forced"
        return 0
    fi

    if [ -f "$CACHE_FILE" ]; then
        cached=$(cat "$CACHE_FILE" 2>/dev/null || true)
        if [ -n "$cached" ] && [ -x "$DIR/slicer_linux_runtime_host_$cached" ]; then
            printf '%s\n' "$DIR/slicer_linux_runtime_host_$cached"
            return 0
        fi
    fi

    for abi in abi1 abi0; do
        if run_probe "$DIR/slicer_linux_runtime_host_$abi"; then
            printf '%s' "$abi" > "$CACHE_FILE"
            printf '%s\n' "$DIR/slicer_linux_runtime_host_$abi"
            return 0
        fi
    done

    if [ -x "$DIR/slicer_linux_runtime_host_abi1" ]; then
        printf '%s\n' "$DIR/slicer_linux_runtime_host_abi1"
        return 0
    fi
    if [ -x "$DIR/slicer_linux_runtime_host_abi0" ]; then
        printf '%s\n' "$DIR/slicer_linux_runtime_host_abi0"
        return 0
    fi
    return 1
}

BIN=$(choose_bin) || {
    echo "no compatible host ABI variant found" >&2
    exit 127
}

if [ "${1:-}" = "--print-bin" ]; then
    printf '%s\n' "$BIN"
    exit 0
fi

export LD_LIBRARY_PATH="$DIR${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec $EXEC_PREFIX "$BIN" "$@"
